# pnpm 配置 - Cloudflare Pages 部署必需

# 允许运行构建脚本 [已迁移至 Convex，Prisma 已移除，保留配置兼容]
# 在 CI 环境中，pnpm 默认会跳过这些脚本
enable-pre-post-scripts=true

# 不使用 frozen-lockfile（虽然在 CI 中默认启用）
# Cloudflare 会自动使用 --frozen-lockfile
# 这个设置确保如果需要可以正常安装
shamefully-hoist=false

# 严格的 peer dependencies（推荐）
strict-peer-dependencies=false