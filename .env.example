# Database — [已迁移至 Convex] 仅旧 Workers 层可能仍需
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your-key"
CLERK_SECRET_KEY="sk_live_your-key"
CLERK_SIGN_IN_URL="/auth/signin"
CLERK_SIGN_UP_URL="/auth/signup"
CLERK_AFTER_SIGN_IN_URL="/dashboard"
CLERK_AFTER_SIGN_UP_URL="/dashboard"
CLERK_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Convex — [已迁移] 主数据源，替代 Prisma/Neon
NEXT_PUBLIC_CONVEX_URL="https://your-convex-url"
CONVEX_DEPLOYMENT="your-convex-deployment"

# External APIs
USDA_API_KEY="your-usda-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Instacart Connect API (US Market)
INSTACART_API_URL="https://connect.instacart.com/v2"
INSTACART_CLIENT_ID="your-instacart-client-id"
INSTACART_CLIENT_SECRET="your-instacart-client-secret"
INSTACART_AFFILIATE_ID="your-instacart-affiliate-id"

# Cron Jobs
CRON_SECRET="your-cron-secret"

# Push Notifications (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# AWS S3 Storage (Optional)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# Redis Cache (Optional - Upstash recommended for serverless)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"
REDIS_URL="redis://localhost:6379"

# Application Settings
LOG_LEVEL="info"
NEXT_PUBLIC_ALLOWED_ORIGINS="http://localhost:3000"
NODE_ENV="development"
