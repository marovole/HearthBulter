# ======================================================
# 当前架构: Convex + Clerk + Cloudflare Pages
# ======================================================

# Convex 实时数据库（必需）
# 访问 https://dashboard.convex.dev 获取
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOYMENT=your-convex-deployment-name

# Clerk 认证配置（必需）
# 访问 https://dashboard.clerk.com 获取
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# 应用配置（Cloudflare 部署用）
BUILD_TARGET=cloudflare
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [已迁移] Supabase 配置 - 已于 2026-01-27 迁移至 Convex，不再需要
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# SUPABASE_SERVICE_KEY=<your-service-role-key>

# ==========================================
# 第三方 API 配置
# ==========================================

# USDA API (免费注册: https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY="your-usda-api-key"

# OpenAI API (用于 AI 营养建议)
OPENAI_API_KEY="your-openai-api-key"

# OpenRouter API (用于 Claude 集成)
OPENROUTER_API_KEY="your-openrouter-key"

# ==========================================
# 可选配置
# ==========================================

# Redis (可选，用于缓存)
# UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"
